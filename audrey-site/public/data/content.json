    "cards": {
      "desc": {
        "label": "WHO AM I??",
        "text": "Hello, I'm Audrey-Lillie. I'm 21, a Sagittarius ᯓ★\n\nI'm passionate about the virtual world, content creation, fashion, pop culture, journaling, sudoku, and much more... but you'll find that out working alongside me!\n\nI'm a one-stop shop for creating all kinds of content. From designing eye-catching graphics, creating compelling marketing materials, or collaborating on creative campaigns, I thrive in environments that encourage innovation, I love talking strategy, understanding the essence of what you do, and developing together content that truly feels like you.",
        "label_en": "",
        "text_en": ""
      },
      "cv": {
        "label": "EXPERIENCE",
        "text": "2026 — present — Social Media and Outreach Intern, Holistic House and Community Healing Foundation\n\n2025 — 2026 — Public Relations Chair, F.A.C.E. Modelling - Rutgers University\nProduced 25+ original graphics and Reels for the club’s Instagram, driving event promotion and membership visibility. Served as a primary point of contact between club leadership and members, managing communications and inquiries through direct outreach..\n\n2025 — present — Head Graphic Designer, SCRAPS Magazine\nOversee all editorial and production operations for a student-run print magazine, delivering 3 issues from concept to final output. Art-direct and design all visual elements — layouts, typography, and photo treatments — across every issue, while leading a creative team of 10 contributors across editing, photography, and design. Organize and direct photo shoots, managing creative vision, talent coordination, and on-set logistics.",
        "label_en": "",
        "text_en": ""
      },
      "edu": {
        "label": "EDUCATION",
        "text": "2023 — 2027 — BFA Graphic Design, Rutgers University - New brunswick, NJ\n\n2019 — 2023 — High School Diploma, The Lawrenceville School - Lawrenceville, NJ",
        "label_en": "",
        "text_en": ""
      },
      "hobbies": {
        "label": "HOBBIES",
        "text": "a list of things I love:\n\n- shopping\n- fashion\n- journaling\n- sudoku\n- modeling\n- playing minecraft",
        "label_en": "",
        "text_en": ""
      },
      "content": {
        "label": "CONTENT CREATION",
        "text": "I also make content on my own channels. Come say hi ✧",
        "label_en": "",
        "text_en": ""
      }
    },
